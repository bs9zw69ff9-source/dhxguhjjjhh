# ── Discord (required) ───────────────────────────────────────────────
# Bot token from the Discord Developer Portal → your app → Bot
DISCORD_TOKEN=
# Application (client) ID from the Developer Portal → General Information
CLIENT_ID=

# ── Server 1 RCON (required) ─────────────────────────────────────────
RCON_HOST_1=127.0.0.1
RCON_PORT_1=9100
RCON_PASSWORD_1=

# ── Server 2 RCON (optional — enables the "Both / Server 2" options) ──
RCON_HOST_2=
RCON_PORT_2=
RCON_PASSWORD_2=

# ── Paths (optional) ─────────────────────────────────────────────────
# ModSave dir holding per-player caps ledgers (used by /checkbalance,
# wages, leaderboard, etc.)
MODSAVE_PATH=/home/steam/pavlovserver/Pavlov/Saved/Config/ModSave
# Override the donator whitelist file location (defaults to the ModSave
# config dir / donator.txt)
DONATOR_PATH=

# ── Channels (optional) ──────────────────────────────────────────────
# Channel ID for the mod-action audit log
MOD_LOG_CHANNEL=
# Channel ID where the caps leaderboard is auto-posted every 6h
LEADERBOARD_CHANNEL=

# ── Access control (optional) ────────────────────────────────────────
# Discord user IDs barred from ALL bot commands. Comma / space / newline
# separated. Owners (OWNER_IDS in index.js) are always exempt. Restart to apply.
# Example: BLACKLIST_IDS=123456789012345678,987654321098765432
BLACKLIST_IDS=

# ── Companion web app (optional — `npm run web`) ─────────────────────
# A fully public dashboard: live servers, caps leaderboard, faction
# rosters, and courier lookup. No login required.
# Port the dashboard listens on (default 8080)
WEB_PORT=8080
# Public base URL of the dashboard (used to build absolute links)
WEB_BASE_URL=http://localhost:8080
# Where the bot writes its JSON data files (default: current dir). Point the
# web app at the same location if it runs from a different working dir.
DATA_DIR=
# Path to the faction role/spawn files on the game-server host (defaults to
# the ModSave/FactionRoles dir). Used by the public Factions page.
FACTION_ROLES_PATH=

# ── Logging (optional) ───────────────────────────────────────────────
# DEBUG | INFO | WARN | ERROR  (default: INFO)
LOG_LEVEL=INFO
