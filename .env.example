# ══════════════════════════════════════════════════════════
#  Pavlov RP Moderation Bot — environment configuration
#  Copy to .env and fill in. Only the REQUIRED block is needed
#  to boot; everything else unlocks an optional feature.
# ══════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=

# ── Optional — theme / branding ───────────────────────────
# Display name stamped on every embed (author header + footer).
# Skin the bot for your RP, e.g. "Mojave Authority", "LSPD Command".
BOT_NAME=

RCON_HOST_1=
RCON_PORT_1=
RCON_PASSWORD_1=

# ── Optional — Server 2 / Server 3 ────────────────────────
RCON_HOST_2=
RCON_PORT_2=
RCON_PASSWORD_2=
RCON_HOST_3=
RCON_PORT_3=
RCON_PASSWORD_3=

# ── Optional — ModSave / economy paths ────────────────────
# Directory of per-player caps ledger files (<playerId>.txt)
MODSAVE_PATH=
# Mirror ModSave writes to a second install (semicolon/comma separated bases)
MODSAVE_SYNC=
MODSAVE_SYNC_SKIP_EXTRA=
MODSAVE_BLACKLIST_PATH=
# Donator whitelist file (defaults to <ModSave>/donator.txt)
DONATOR_PATH=

# ── Optional — Pavlov install roots / logs ────────────────
# Base install dir(s) for faction/rank/blacklist files
PAVLOV_BASE_1=
PAVLOV_BASES=
# Pavlov.log path(s) for the IP ban-evasion tracker (comma/colon separated).
# Auto-detected if unset; run `node ipBans.js` to verify the log format.
PAVLOV_LOGS=

# ── Optional — Discord channels ───────────────────────────
MOD_LOG_CHANNEL=
BAN_LOG_CHANNEL=
LEADERBOARD_CHANNEL=
PLAYTIME_LB_CHANNEL=
PLAYERLIST_CHANNEL=
DASHBOARD_CHANNEL=
KILLFEED_CHANNEL=
MENU_PANEL_CHANNEL=
LINK_REQUEST_CHANNEL=
UPDATE_LOG_CHANNEL=
# Private admin channel for the live connection feed (exposes player IPs — keep private).
# A webhook URL; works with no channel permissions.
CONNECT_WEBHOOK_URL=

# ── Optional — role IDs ───────────────────────────────────
LINK_APPROVER_ROLE=
MENU_ROLE_STAFF=
MENU_ROLE_HIGHSTAFF=
MENU_ROLE_FACTION=
MENU_ROLE_BLACKLIST=

# ── Optional — VPN/proxy detection (IP enforcement) ───────
IPHUB_API_KEY=
IPQS_API_KEY=
# Geolocation via ipinfo.io. Works without a token (rate-limited); add a free
# token for the larger quota (ipinfo.io/signup).
IPINFO_TOKEN=

# ── Optional — OS firewall block (ufw) for permanent/VPN bans ─
# Set to 1 to also block the IP at the OS firewall on EVERY ban
# (`sudo ufw insert 1 deny from <ip>`) — but ONLY as a manual owner action via the
# /firewall command (block/unblock/status). ufw is never applied automatically on a
# ban/unban. Requires the bot to run as root, or passwordless sudo for ufw:
#   <botuser> ALL=(root) NOPASSWD: /usr/sbin/ufw
UFW_BLOCK=

# ── Optional — web dashboard + moderation panel ───────────
# Opt-in info dashboard (public, read-only) plus a password-gated admin panel that
# can kick / ban / unban / mute using the same logic as the Discord commands.
# Set WEB_ENABLE=1 to turn it on.
WEB_ENABLE=
# Single shared admin password. If unset, the admin panel stays locked out.
WEB_ADMIN_PASSWORD=
# Bind address + port (default 0.0.0.0:8080). Keep the port firewalled / behind a
# reverse proxy — expose it deliberately, not by accident.
WEB_HOST=
WEB_PORT=
# Set to 1 when serving over HTTPS (adds the Secure flag to the session cookie).
WEB_SECURE_COOKIE=
# Set to 1 ONLY when behind a trusted reverse proxy (nginx) that sets
# X-Forwarded-For — lets per-IP login throttling see the real client IP.
WEB_TRUST_PROXY=
# Optional display name shown in the page header (default: NuclearRP).
WEB_SITE_NAME=

# ── Optional — access control & misc ──────────────────────
# Space/comma separated Discord user IDs barred from ALL commands
BLACKLIST_IDS=
# Appeal link shown in ban messages
APPEAL_LINK=
BUILD_ID=
# One of: DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=
# How often to export the SQLite DB back to the .json backup files, in ms
# (default 600000 = 10 min; set 0 to disable)
DB_EXPORT_INTERVAL_MS=

# ── Optional — secondary faction bot (if used) ────────────
FACTION_BOT_TOKEN=
FACTION_CLIENT_ID=
