# ── Discord (required) ───────────────────────────────────────────────
# Bot token from the Discord Developer Portal → your app → Bot
DISCORD_TOKEN=
# Application (client) ID from the Developer Portal → General Information
CLIENT_ID=

# ── Server 1 RCON (required) ─────────────────────────────────────────
RCON_HOST_1=127.0.0.1
RCON_PORT_1=9100
RCON_PASSWORD_1=

# ── Server 2 RCON (optional — enables the "Both / Server 2" options) ──
RCON_HOST_2=
RCON_PORT_2=
RCON_PASSWORD_2=

# ── Paths (optional) ─────────────────────────────────────────────────
# ModSave dir holding per-player caps ledgers (used by /checkbalance,
# wages, leaderboard, etc.)
MODSAVE_PATH=/home/steam/pavlovserver/Pavlov/Saved/Config/ModSave
# Full path of the donator whitelist file the server reads. Defaults to
# <ModSave>/FactionRoles/donator.txt — set this if yours differs.
DONATOR_PATH=

# ── Channels (optional) ──────────────────────────────────────────────
# Channel ID for the mod-action audit log
MOD_LOG_CHANNEL=
# Channel ID for BAN logs (tempban/permban/hardban/auto-ban). If blank, ban logs
# go to MOD_LOG_CHANNEL with everything else.
BAN_LOG_CHANNEL=
# Channel ID where the caps leaderboard is auto-posted every 6h
LEADERBOARD_CHANNEL=
# Channel ID for the live player list (auto-edits one message every 30s).
# Has a hardcoded default in index.js; set this to override it.
PLAYERLIST_CHANNEL=
# Channel ID where the playtime (top 30) leaderboard auto-posts every 6h.
# Has a hardcoded default in index.js; set this to override it.
PLAYTIME_LB_CHANNEL=

# ── Access control (optional) ────────────────────────────────────────
# Discord user IDs barred from ALL bot commands. Comma / space / newline
# separated. Owners (OWNER_IDS in index.js) are always exempt. Restart to apply.
# Example: BLACKLIST_IDS=123456789012345678,987654321098765432
BLACKLIST_IDS=

# ── IP bans / alt detection (optional — ipBans.js) ───────────────────
# Pavlov server log file(s) to tail for IP<->player mapping. Comma or colon
# separated. LEAVE BLANK to auto-detect the active Pavlov.log under the usual
# locations (/home/*, /root, /opt, /srv) — set it only to be explicit or if the
# log lives somewhere unusual. When a player is banned, the IPs they've used are
# flagged; any account that then connects from a flagged IP is auto-banned over
# RCON. No firewall needed. To verify what gets read, run:  node ipBans.js
# Example: PAVLOV_LOGS=/home/steam/pavlovserver/Pavlov/Saved/Logs/Pavlov.log,/home/steam/pavlovserver1/Pavlov/Saved/Logs/Pavlov.log
PAVLOV_LOGS=
# Live connection feed: a Discord channel webhook URL. Posts a new message
# (name · ID · IP) every time a player joins. Create it in Discord under
# Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# Use a PRIVATE admin channel — it exposes player IP addresses.
CONNECT_WEBHOOK_URL=

# ── Logging (optional) ───────────────────────────────────────────────
# DEBUG | INFO | WARN | ERROR  (default: INFO)
LOG_LEVEL=INFO

# ── Misc (optional) ──────────────────────────────────────────────────
# Build/version stamp shown in /help and /ping (defaults to vX.Y.Z-<date>).
BUILD_ID=

# ── Faction bot (optional second bot) ────────────────────────────────
# A dedicated Discord application that hosts the /faction command.
# Leave unset to keep it on the main bot.
# Runs inside the same process — no extra pm2 app needed.
FACTION_BOT_TOKEN=
FACTION_CLIENT_ID=

# ---- Live status dashboard (optional) ----
# Channel ID for an always-on server-status dashboard that auto-refreshes
# every 30s (health, player-count bars, map/mode, gateway ping). Also
# available on demand via /dashboard. Leave blank to disable.
DASHBOARD_CHANNEL=
