# ── Discord (required) ───────────────────────────────────────────────
# Bot token from the Discord Developer Portal → your app → Bot
DISCORD_TOKEN=
# Application (client) ID from the Developer Portal → General Information
CLIENT_ID=

# ── Server 1 RCON (required) ─────────────────────────────────────────
RCON_HOST_1=127.0.0.1
RCON_PORT_1=9100
RCON_PASSWORD_1=

# ── Server 2 RCON (optional — enables the "Both / Server 2" options) ──
RCON_HOST_2=
RCON_PORT_2=
RCON_PASSWORD_2=

# ── Paths (optional) ─────────────────────────────────────────────────
# ModSave dir holding per-player caps ledgers (used by /checkbalance,
# wages, leaderboard, etc.)
MODSAVE_PATH=/home/steam/pavlovserver/Pavlov/Saved/Config/ModSave
# Override the donator whitelist file location (defaults to the ModSave
# config dir / donator.txt)
DONATOR_PATH=

# ── Channels (optional) ──────────────────────────────────────────────
# Channel ID for the mod-action audit log
MOD_LOG_CHANNEL=
# Channel ID where the caps leaderboard is auto-posted every 6h
LEADERBOARD_CHANNEL=

# ── Logging (optional) ───────────────────────────────────────────────
# DEBUG | INFO | WARN | ERROR  (default: INFO)
LOG_LEVEL=INFO
