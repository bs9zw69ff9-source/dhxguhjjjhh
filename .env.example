# ══════════════════════════════════════════════════════════
#  Pavlov RP Moderation Bot — environment configuration
#  Copy to .env and fill in. Only the REQUIRED block is needed
#  to boot; everything else unlocks an optional feature.
# ══════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
# YOUR SERVER'S ID. Not strictly required to boot, and the single most likely
# reason a newly added command "does not exist" after a deploy.
#
# With GUILD_ID set, slash commands register to that guild and appear within
# SECONDS. Without it they register GLOBALLY, and Discord takes UP TO AN HOUR to
# propagate a global command - long enough to conclude the deploy failed when it
# did not. The startup log says which happened:
#   "Registered N command(s) in guild <name>"        <- instant
#   "Registered N global command(s) - propagation..."  <- up to an hour
#
# Enable Developer Mode in Discord, right-click your server, Copy Server ID.
GUILD_ID=

# ── Optional — install it on your ACCOUNT as well as a server ─
# Set to 1 to register as a USER-INSTALLABLE app, so the commands follow the
# installing account into DMs, group DMs, and servers the bot is not in.
#
# THIS IGNORES GUILD_ID AND FORCES GLOBAL REGISTRATION. Discord does not allow
# the two together: integration types and contexts exist only on global commands,
# and a guild command is guild-installed by definition. Registering both would
# put every command in that guild's picker TWICE. So turning this on costs you
# instant registration - a global command takes up to an hour to appear after a
# deploy. That trade is the whole of this setting.
#
# ALSO ENABLE IT IN THE DEVELOPER PORTAL: Installation -> Installation Contexts
# -> tick "User Install". The bot cannot set that for you, and without it the
# install button never offers "Add to My Apps" no matter what this says.
#
# PERMISSIONS DO NOT FOLLOW YOU OUT OF A SERVER. Mod, admin, faction leader and
# police are Discord ROLE checks, and in a DM there is no member to read roles
# from - so those tiers are all false and only OWNER_IDS and SUPER_OWNER_IDS,
# which are user ids, still apply. Useful if you are an owner. Not useful for
# giving moderators access from their DMs, which it cannot do.
USER_APP=

# ── Optional — theme / branding ───────────────────────────
# Display name stamped on every embed (author header + footer).
# Skin the bot for your RP, e.g. "Mojave Authority", "LSPD Command".
BOT_NAME=

RCON_HOST_1=
RCON_PORT_1=
RCON_PASSWORD_1=

# ── Optional — Server 2 / Server 3 ────────────────────────
RCON_HOST_2=
RCON_PORT_2=
RCON_PASSWORD_2=
RCON_HOST_3=
RCON_PORT_3=
RCON_PASSWORD_3=

# ── Optional — ModSave / economy paths ────────────────────
# Directory of per-player caps ledger files (<playerId>.txt)
MODSAVE_PATH=
# Mirror ModSave writes to a second install (semicolon/comma separated bases)
MODSAVE_SYNC=
MODSAVE_SYNC_SKIP_EXTRA=
# THE GAME'S OWN BAN FILE. Two jobs: it is the message a banned player sees, and
# it is how bans issued from the in-game admin menu reach the bot, which imports
# it every 5 minutes.
#
# The server reads this file ITSELF, so a player left listed in it stays banned
# however many Unban commands RCON accepts. That cuts both ways - point this at
# the wrong file and /unban will look like it works and not stick.
#
# Pavlov writes the EOS UniqueID as the header for an in-game ban, where the bot
# writes a username. The importer resolves one to the other and treats them as
# one player.
MODSAVE_BLACKLIST_PATH=
# Donator whitelist file (defaults to <ModSave>/donator.txt)
DONATOR_PATH=

# ── Optional — Pavlov install roots / logs ────────────────
# Base install dir(s) for faction/rank/blacklist files
PAVLOV_BASE_1=
PAVLOV_BASES=
# Pavlov.log path(s) for the IP ban-evasion tracker (comma/colon separated).
# Auto-detected if unset; run `node ipBans.js` to verify the log format.
PAVLOV_LOGS=

# ── Optional — Discord channels ───────────────────────────
# Staff log: general staff actions (kicks, warnings, faction/economy/config/menu
# changes). Defaults to a built-in channel; set this to override.
MOD_LOG_CHANNEL=
# Staff Punishment log: bans, temp-bans, unbans, auto-bans. Defaults to a built-in
# channel; set this to override.
BAN_LOG_CHANNEL=
LEADERBOARD_CHANNEL=
# Arrests / jail-time "most wanted" board (auto-updates every 30s).
ARREST_LEADERBOARD_CHANNEL=
# Live warrant board. OLDEST WARRANT FIRST - it is a work queue for officers, not a
# leaderboard. Give it its own channel: two boards in one channel means two permanent
# posts, which looks exactly like a bug and is not one.
WARRANT_BOARD_CHANNEL=
# DEAD. Read by the Node bot; the C# bot ignores it. The player-count voice
# channels below are what replaced it, and /players lists the names.
PLAYERLIST_CHANNEL=
# ── Player-count voice channels ───────────────────────────
# Live counts as VOICE CHANNEL NAMES in the sidebar, which is what replaced the
# player-list board. Readable without opening anything, and it carries no player
# names - so it does not publish who is on the server to everybody who can see
# the channel list. /players still lists the names, for staff.
#
#   PLAYER_COUNT_CHANNELS   one voice channel id per server, IN SERVER ORDER, so
#                           the first id is RCON_*_1. Named "Server 1: 3/24", or
#                           "Server 1: Offline" when systemd says the unit is down.
#   SHACK_TOTAL_CHANNEL     one more channel for the platform-wide total from the
#                           Pavlov master server. Named "Pavlov Shack: 287".
#
# THE BOT NEEDS MANAGE CHANNELS *ON EACH OF THESE CHANNELS*. A server-wide grant
# that a channel override denies fails per channel, which looks like the feature
# being broken rather than a permission being missing. /counts reports which.
#
# Make them voice channels nobody can connect to: deny Connect for @everyone and
# leave View Channel allowed. They are read, never joined.
#
# UPDATED EVERY SIX MINUTES, NOT FASTER, and that is deliberate. Discord rate
# limits channel renames to TWO PER TEN MINUTES per channel, and the limit is not
# shared with anything else. A one-minute tick would spend the budget in two
# minutes and then silently stop updating. An unchanged name is not written at
# all, so an idle server costs nothing and the whole allowance is there for the
# minutes the count is actually moving.
#
# /counts forces an update now, and reports what it did per channel.
PLAYER_COUNT_CHANNELS=
SHACK_TOTAL_CHANNEL=
# Self-serve RCON menu panel: a channel with a Get Menu button. The tier comes from
# the claimer's roles below, never from anything they type.
MENU_PANEL_CHANNEL=
UPDATE_LOG_CHANNEL=
# Verification: public channel with the Verify button, and the private staff
# channel that receives accept/deny requests.
VERIFY_CHANNEL=
VERIFY_STAFF_CHANNEL=
# Channel every police log posts to - arrests, sentence releases, warrants, rank
# suspensions (falls back to MOD_LOG_CHANNEL). ARREST_CHANNEL optionally overrides
# just the arrest bookings.
POLICE_LOG_CHANNEL=
ARREST_CHANNEL=
# Private admin channel for the live connection feed (exposes player IPs — keep private).
# A webhook URL; works with no channel permissions.
CONNECT_WEBHOOK_URL=
# Plain-text join/leave log and kill log, each on its own webhook. These carry no IP
# or account data, so they are safe in a public channel.
# NOTE: a webhook URL is a CREDENTIAL - anyone holding it can post to that channel.
# Keep it in .env (gitignored) and never commit it. Rotate it in Discord if it leaks.
JOIN_WEBHOOK_URL=
KILL_WEBHOOK_URL=
# The staff log as a WEBHOOK rather than a channel. MOD_LOG_CHANNEL is the
# channel counterpart; set both and both receive it, which is how you keep a
# private archive of staff actions alongside the visible one.
STAFF_WEBHOOK_URL=
# Money log: reports every balance movement read from the ModSave ledgers, e.g.
#   +400 to player1
#   -345 to player2
# Requires MODSAVE_PATH. Player names are visible, balances are not - only the delta.
MONEY_WEBHOOK_URL=
# How often the ledgers are polled, ms (default 10000, floor 2000).
# MONEY_LOG_INTERVAL_MS=10000

# ── Optional — role IDs ───────────────────────────────────
# Role granted when a member is verified (grants channel access). The Unverified
# role is created automatically.
VERIFIED_ROLE=
# Which role earns which menu. HIGHSTAFF outranks STAFF; BLACKLIST bars a member
# outright and wins over both.
# Whitelist-manager roles are NOT set here. /setroles assigns them per faction at
# runtime, so they can be changed without a restart. There was a MAFIA_ROLE entry
# here that nothing ever read; it is gone rather than left to look load-bearing.
MENU_ROLE_STAFF=
MENU_ROLE_HIGHSTAFF=
MENU_ROLE_BLACKLIST=

# ── Optional — VPN/proxy detection (two-tier consensus) ───
# TIER 1 - SCREENING: run on every not-yet-checked IP.
#   ipapi.is      1,000/day   (works with NO key; add one for higher limits)
#   sntlhq.com    1,000/HOUR  (needs a key - free, no card. Sign up at sntlhq.com)
#   iphub.info    1,000/day   (needs a key)
#   proxycheck.io 100/day keyless, 1,000/day with a free key
#
# PROXYCHECK IS TIER 1 DESPITE THE SMALL QUOTA, because it is the only source of
# the consumer VPN BRAND ("NordVPN") shown in the feed, /inspect and auto-ban
# logs. Screening every connection is what makes the brand available even for
# addresses that come back clean - so on a busy server this is the quota that
# runs out first, and the free key is worth having.
IPAPIIS_KEY=
SENTINEL_API_KEY=
IPHUB_API_KEY=
PROXYCHECK_API_KEY=
# TIER 2 - CONFIRMATION: small quota, high accuracy. Only ever queried for an IP
# the screening tier already flagged, so a clean IP costs nothing here.
#   ipqualityscore  ~35/day   (needs a key)
IPQS_API_KEY=
# Consensus thresholds (defaults shown). SCREEN_MIN = tier-1 hits needed to
# escalate to tier 2. CONFIRM_MIN = tier-2 hits needed to auto-ban. BAN_MIN =
# tier-1 hits needed to ban when no tier-2 detector could answer at all.
#
# BAN_MIN COUNTS ANSWERING SCREENERS, NOT CONFIGURED ONES, so removing a detector
# or exhausting its quota makes each remaining one count for more. Raise it if
# you add keys.
# VPN_SCREEN_MIN=1
# VPN_CONFIRM_MIN=1
# VPN_BAN_MIN=2
# (VPN_SCREEN_BAN_MIN is the old name for VPN_BAN_MIN. Still read, so an existing
#  .env is not silently reset to the default, but prefer the new name.)
# How long a cached IP verdict stays trusted before it is re-looked-up. An address
# that was residential a year ago can be a VPN exit node today (and vice versa).
# Default 30 days; set 0 to cache forever.
# VPN_CACHE_TTL_DAYS=30
# Geolocation via ipinfo.io. Works without a token (rate-limited); add a free
# token for the larger quota (ipinfo.io/signup).
IPINFO_TOKEN=
# Geoapify (geoapify.com). Optional, and does two separate jobs:
#
#   1. A STANDBY geolocator. Location lookups go to ip-api.com first: it is keyless
#      AND returns the ISP and ASN that ban-evasion detection matches against the
#      networks banned players used. Geoapify returns neither, so it is only
#      consulted when ip-api gives no answer - rate-limited, blocked, or down.
#
#   2. The map image in /iplookup. This needs the key even when ip-api supplied the
#      coordinates, because the map is rendered by Geoapify.
#
# The bot downloads the map and uploads it to Discord as a file. It never puts the
# map URL in the embed - the key travels in that URL, and anyone who can see the
# message could read it straight out of the image address.
#
# Leave blank: no map, and geolocation works exactly as before.
GEOAPIFY_API_KEY=

# ── Optional — OS firewall block (ufw) for permanent/VPN bans ─
# Set to 1 to also block the IP at the OS firewall on EVERY ban
# (`sudo ufw insert 1 deny from <ip>`) — but ONLY as a manual owner action via the
# /firewall command (block/unblock/status). ufw is never applied automatically on a
# ban/unban. Requires the bot to run as root, or passwordless sudo for ufw:
#   <botuser> ALL=(root) NOPASSWD: /usr/sbin/ufw
UFW_BLOCK=

# ── Optional — the Pavlov servers themselves ──────────────
# The systemd units the bot starts, stops and reports on, COMMA separated, in
# server order so the first matches RCON_*_1. Default:
#   pavlovserver,pavlovserver1,pavlovserver2
# /serverswitch and the crash recovery both act on these, and the player-count
# channels use them to tell "empty" from "not running".
#
# Split on COMMAS ONLY. Spaces are not separators: "bad name here" would become
# three tokens that each validate individually, so a malformed entry would
# silently become three units instead of being rejected as one.
PAVLOV_UNITS=
# systemctl must run as root. Detected automatically; set 1 to force sudo or 0 to
# force direct, for a host where the detection is wrong. Forcing direct as a
# non-root user means every server control command is refused.
PAVLOV_SYSTEMCTL_SUDO=
# Which game version to match in the public server browser. Unset means whatever
# the master server reports.
PAVLOV_VERSION=
# The capacity shown in a player-count channel for a server that has never
# answered. Default 24. A live reading always wins, and the last one successfully
# read wins over this - only a server that has never once answered falls back.
SERVER_MAX_PLAYERS=

# ── Optional — where the bot keeps its own data ───────────
# bot.db and the JSON export. Defaults to ./data. This is the bot's own state,
# not a game file - back this up.
DATA_DIR=

# ── Optional — timings ────────────────────────────────────
# How often the cash leaderboard redraws, ms. Default 60000.
LEADERBOARD_INTERVAL_MS=
# How often each RCON connection is health-checked, ms. Default 60000. Pavlov
# recycles a connection after five minutes, so raising this past that means the
# bot finds out a server is gone only when a command needs it.
RCON_HEALTH_INTERVAL_MS=

# ── Optional — RCON tuning ────────────────────────────────
# Idempotent RCON reads (RefreshList/ServerInfo) are coalesced for this many ms, so the
# player list, leaderboards, ban sweep and health check share one lookup
# instead of each opening its own connection. Pavlov serves RCON on the game thread, so
# this reduces load on the server itself. Default 2500. Set 0 to disable.
# RCON_READ_CACHE_MS=2500

# ── Optional — monitoring / observability ─────────────────
# Prometheus + health endpoints. DISABLED unless METRICS_PORT is set.
#   GET /metrics   Prometheus text exposition
#   GET /health    full JSON report (200 healthy or degraded, 503 unhealthy)
#   GET /healthz   liveness (always open, even with a token)
#   GET /ready     readiness
# Binds to 127.0.0.1 by default ON PURPOSE - these endpoints expose service names,
# error messages and internal state. Only widen METRICS_HOST deliberately, and set
# METRICS_TOKEN if you do.
# METRICS_PORT=9464
# METRICS_HOST=127.0.0.1
# METRICS_TOKEN=

# ── Optional — plugins ────────────────────────────────────
# Plugins are auto-discovered from plugins/. Deny-list, or restrict to an allow-list.
# PLUGINS_DISABLED=analytics
# PLUGINS_ENABLED=analytics

# ── REQUIRED on the C# bot — access control ───────────────
# Owner / super-owner Discord user IDs (comma or space separated). Super owners
# always count as owners too.
#
# THE TWO BOTS DIFFER HERE, and it is the one thing to get right before cutting over:
#   C# (production)  reads these ONLY from this file. Leave them blank and NOBODY
#                    holds owner tier - every owner-gated command refuses everyone.
#                    Role-based tiers (mod/admin) keep working, so the gap is quiet.
#                    The bot logs a warning at startup when both are empty.
#   Node (rollback)  falls back to owner IDs hardcoded in index.js if these are blank.
OWNER_IDS=
SUPER_OWNER_IDS=

# In-game player names that can NEVER be auto-banned (comma separated) - your own
# accounts. Not a Discord ID: this is the name Pavlov reports.
#
# Deliberately env-only rather than database-backed. A false-positive auto-ban on
# your own account locks you out of your own server, and recovering needs console
# access; a list living in the database could be emptied by anything with write
# access to it, including a bug in this bot.
MASTER_NAMES=
# Space/comma separated Discord user IDs barred from ALL commands
BLACKLIST_IDS=
# Appeal link shown in ban messages
APPEAL_LINK=
BUILD_ID=
# One of: DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=
# How often to export the SQLite DB back to the .json backup files, in ms
# (default 600000 = 10 min; set 0 to disable)
DB_EXPORT_INTERVAL_MS=

# ── Optional — police payroll ─────────────────────────────
# Wages for faction members on the roster. Off unless PAYROLL_AMOUNT is positive.
#
# ACCRUED WHILE ON DUTY, BANKED WHEN THEY LOG OFF. Balances live in
# modsave/<player>.txt, and the game rewrites that file from memory while a player is
# connected - so anything written mid-session is overwritten on their next save. The
# wage is therefore held in the bot's database while they play and written to the
# ledger on the first tick after they leave.
#
# The bot never CREATES a ledger; if a player has not banked in game yet, the wage
# stays owed until the game makes their file. It refuses to accrue or bank from a
# stale RCON player list, refuses a second accrual inside one period, and accrues
# exactly ONE period after an outage rather than a backlog.
PAYROLL_AMOUNT=
PAYROLL_INTERVAL_MINUTES=30
PAYROLL_FACTION=NYPD

# ── Optional — money anomaly alerts ───────────────────────
# Flags a player who earns more than THRESHOLD inside WINDOW minutes. Off unless
# MONEY_ALERT_THRESHOLD is set.
#
# CREDITS ONLY - spending is not suspicious, and netting the two off would let
# somebody hide a million in income behind a million in outgoings. The window slides,
# so a hundred small credits are caught as well as one huge one. Alerts go to the
# staff log, with a 30-minute cooldown per player so one spree is reported once.
MONEY_ALERT_THRESHOLD=
MONEY_ALERT_WINDOW_MINUTES=15

# ── Optional — crash auto-recovery ────────────────────────
# Restarts a Pavlov server that systemd reports as FAILED. Set to 1 to enable.
#
# Only "failed" - never "inactive", which is what /serverswitch stop produces, and
# never "unknown", which just means systemctl could not be read. Capped at 3 restarts
# per 30 minutes per unit; past that it stops and says so once, because a server that
# will not start needs a person rather than another restart.
CRASH_RECOVERY=

# ── Removed with the Node bot ─────────────────────────────
# These were read by the Node implementation, which has been removed. The C# bot
# does not read them and setting them does nothing:
#   VPNAPI_KEY           vpnapi.io was removed as a detector; the key is not read
#   PLAYERLIST_CHANNEL   replaced by the player-count voice channels
#   BUILD_ID             replaced by the commit stamped into the binary at build
#                        time, which /health shows in its footer
#   UPDATE_LOG_CHANNEL   the changelog poster was never ported
#
# ── Whitelists ────────────────────────────────────────────
# WHERE THE ROSTER .txt FILES LIVE. Without this every /whitelist add, /promotion
# and /demotion refuses, because the bot has nowhere to write the file the game
# actually reads. Point it at the directory holding policespawn.txt,
# gambinospawn.txt and colombospawn.txt - on most installs:
#   <PAVLOV_BASE_1>/Pavlov/Saved/Config/ModSave/FactionRoles
# The bot never creates this directory. A path that does not exist is treated as
# not configured, on the grounds that a wrong path building a tree the game never
# reads is worse than a refusal that says so.
#
# EACH FACTION HAS TWO KINDS OF FILE. The rank files (policecadet.txt and up) say
# what a member is; the SPAWN file (policespawn.txt) says whether they are in the
# faction at all, and it is the one the game checks before letting somebody play
# as it. The bot maintains both. The mafias have no ladder, so their spawn file
# is their only file.
#
# ACCESS. /whitelist add, remove, promotion and demotion are Whitelist Leader, or
# a per-faction role for one roster only. /whitelist wipe is OWNER and asks for a
# confirmation: it empties every file a faction owns, and the game reads those
# live, so the members are out the moment it is written. A pre-write copy of each
# file goes to the backup directory, which is the only undo there is.
FACTION_ROLES_PATH=

# WHICH FACTIONS THIS BOT RUNS. Unset means the built-in set - Gambino, Colombo
# and the NYPD - which is what every normal deployment wants and needs no file.
#
# Point it at a JSON file and that file REPLACES the built-in set entirely, which
# is how one binary runs a second, themed bot beside the normal one. See
# SECOND-BOT.md, and factions.fallout.example.json for a working template.
#
# A file that cannot be used STOPS THE BOT with the problems listed, rather than
# quietly falling back - a themed bot running the police roster looks exactly
# like the file being ignored, because it is. The startup log names the set that
# actually loaded; that line is the check worth glancing at after a deploy.
#
# SHARING ONE GAME SERVER: the roster FILE NAMES must not collide with the other
# bot's. The bot refuses to start if two factions in ITS file collide, but it
# cannot see the other bot's roster. SECOND-BOT.md lists what else must not be
# shared - the ban list and payroll in particular, because both rewrite a whole
# file from one bot's database and would erase the other's.
FACTIONS_PATH=

# PATHS THIS BOT MUST NEVER WRITE TO. Comma separated. Reads are unaffected.
#
# FOR A SECOND BOT SHARING ONE GAME SERVER. Several subsystems here rewrite a
# WHOLE file from this bot's own database - the ban list, Pavlov's whitelist, a
# player's balance. Two bots pointed at one file erase each other's work on a
# timer, and the loser is whichever wrote first.
#
# Leaving a setting blank is still the way to turn a feature off. This is the
# belt to that pair of braces, and it earns its place because the second bot's
# .env is usually a COPY of the first's - so every shared path is already in it,
# correct, and pointing at files it must not touch.
#
#   IGNORE_PATHS=/home/steam/.../ModSave/blacklist.txt,/home/steam/.../whitelist.txt
#
# Name a directory to cover everything under it, or a single file. Matching is
# separator-bounded, so "/home/steam/pavlovserver" does NOT also cover
# "/home/steam/pavlovserver-backup" or "pavlovserver2".
#
# NAME FILES, NOT THE ModSave TREE, if this bot manages rosters. FactionRoles
# lives inside ModSave, so ignoring the whole tree stops this bot writing its own
# whitelists - the bot REFUSES TO START on that combination rather than letting
# you find it when /whitelist add fails forever.
#
# A refused write is logged once per path, not once per attempt, and the startup
# summary lists what is ignored. Reads still work, which is deliberate: the
# second bot needs to read the rosters to enforce one faction per player, and a
# read cannot corrupt a file somebody else owns.
IGNORE_PATHS=

# ── Intelligence surfaces (no configuration needed) ───────
# These read what the other systems already record and need no settings:
#   /player       one profile per player, with an explainable risk score
#   /case         investigations, with a tamper-evident evidence chain
#   /eventlog     one ordered timeline across every system
#   /serverstats  player and moderation activity over a period
#   /staff        staff activity, and bursts against somebody's own baseline
#   /factionstats roster activity, rank distribution, who to review
#   /economy      earnings that do not look like play (needs MONEY_ALERT_THRESHOLD)
#   /investigate  the above, assembled for one player, server window or case
#
# ACCESS. /player, /case, /eventlog, /serverstats and /investigate are Mod.
# /staff and /economy are Admin. /factionstats is Faction Leader. /plugins is
# Owner. Addresses are Admin-only wherever they appear, and the split is in code
# rather than config on purpose.
#
# NONE OF THESE ACT. Every one flags, scores or reports; bans, demotions and
# money movements stay with the existing commands and a human.

# ── Plugins ───────────────────────────────────────────────
# Where plugin assemblies live. Defaults to ./plugins.
PLUGIN_DIR=
# Allow-list: run EXACTLY these, by plugin name, comma separated. Unset means
# every plugin found in the directory is loaded.
PLUGINS_ENABLED=
# Deny-list: refuse these, by name. WINS OVER THE ALLOW-LIST, so disabling a
# misbehaving plugin works whether or not you also maintain an allow-list.
PLUGINS_DISABLED=
#
# THERE IS NO RUNTIME TOGGLE, and that is deliberate. A plugin loads into the
# host's AssemblyLoadContext and .NET cannot unload one, so a /plugin disable
# command could stop a plugin's work but not unload its code or detach what it
# subscribed to. A button reporting a disable it had not performed is worse than
# editing this file and restarting. /plugins shows what the settings above did.
#
# PERMISSIONS. A plugin declares what it needs and only reaches that; anything
# undeclared resolves to nothing and is logged. Scopes:
#   plugin.player.read      plugin.player.network    plugin.moderation.read
#   plugin.moderation.write plugin.economy.read      plugin.economy.write
#   plugin.rcon.execute     plugin.timeline.read
# This stops mistakes and stops a manifest being a lie. It does NOT contain a
# hostile plugin - nothing in-process can. Only install plugins you trust.

# ── Timeline / event log ──────────────────────────────────
# /eventlog reads one ordered account of everything: joins, staff actions,
# security detections, economy and faction changes.
#
# This is the ONE dataset held in a real SQLite table rather than as a JSON
# document, because it is append-heavy and its queries are all "this player,
# last six hours". The table is created automatically inside the existing
# bot.db on first start - there is no migration step and nothing to run by hand.
#
# How many days of events to keep. 0 turns the timeline off entirely and the
# table is never written. Default 90.
EVENT_RETENTION_DAYS=90

# ── Player intelligence ───────────────────────────────────
# /player needs no configuration. It reads what the other systems already record,
# so it works on a fresh install and gets richer as they fill in.
#
# ACCESS: /player is Mod. Its `security` and `associations` sections are ADMIN,
# because addresses identify somebody outside the game. Moderators keep the VPN
# and proxy verdicts, which is what they need to moderate. Nothing here can be
# widened by config - the split is in the code on purpose.

# ── Optional — secondary faction bot (if used) ────────────
# A SECOND DISCORD IDENTITY, NOT A SECOND PROCESS. Set both and the host opens a
# second gateway connection from the same process, under its own name and avatar,
# and moves the whitelist commands onto it. It reads THIS file - there is no
# second .env and no second working directory to keep in step.
#
# Set only one of the two and the whitelist commands stay on the main bot. A bad
# token here cannot take the main bot down with it; it logs and carries on.
FACTION_BOT_TOKEN=
FACTION_CLIENT_ID=
