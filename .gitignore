node_modules/
.env

# The bot's data directory (DATA_DIR, default data/): bot.db and the JSON exports beside it.
# Ignored whole, not dataset by dataset: a list by name misses every new dataset, and
# deploy.sh's clean then treats its export as a stray file.
/data/

# SQLite database (bot.db) + WAL sidecars — runtime state
bot.db
bot.db-wal
bot.db-shm

# Watchdog config (holds a webhook URL)
watchdog.env
backup.env

# Process lock + logs
bot.lock
*.log

# Atomic-write temp files
*.tmp
*.tmp.*
*.corrupt-*

# Runtime state (index.js FILES map) — created automatically, not source
tempbans.json
roles.json
wages.json
playtime.json
modlog.json
faction_ranks.json
faction_config.json
faction_audit.json
faction_backup.json
menu_grants.json
menu_panel.json
menu_roles.json
menu_links.json
lastseen.json
known_players.json
user_blacklist.json
user_unbarred.json
autorotate.json
mutes.json
discord_links.json
autoban_exempt.json
donator_suspend.json
casino_config.json
casino_quota.json
casino_pot.json
update_log_state.json
ban_reconcile_state.json
autopost_state.json
vpn_checks.json
server_stats.json
warrants.json
verifications.json
verify_state.json
arrests.json
sentences.json
rank_suspensions.json
police_config.json

# Runtime state (ipBans.js)
ip_registry.json
ip_blacklist.json
ip_flagged_names.json
ip_flagged_ids.json
ip_untracked.json
ip_untracked_ids.json
ip_cutoff.json
ip_pending_flag.json
ip_manual.json
kd.json
kill_log.json

# Legacy runtime state (older bot versions)
player_notes.json

# Game-server side files sometimes written locally
donator.txt
blacklist.txt
banlist.txt
package.json.deployed

# Pre-write roster snapshots the bot creates at runtime — recoverable state,
# not source. These were tracked by accident.
faction_file_bak/

# Build output. dotnet-out/ is the removed C# bot's publish folder; it stays ignored so a
# leftover copy on a server is neither committed nor deleted by deploy.sh's git clean.
dotnet-out/
rust-out/
/logs/
