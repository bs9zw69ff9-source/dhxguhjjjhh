<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>PavlovBot.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mirrors PavlovBot.Host: the log tailer's ability to read Pavlov.log while the game
         server holds it open depends on this switch, so the test process must be configured
         the same way or LogTailerLockingTests would be testing a different runtime than the
         one that ships. -->
    <RuntimeHostConfigurationOption Include="System.IO.DisableFileLocking" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real capture of the Pavlov master server's response. The list is third-party and
         can change shape under us, so the parser is tested against what it actually returns
         rather than against what we think it returns. -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PavlovBot.Core/PavlovBot.Core.csproj" />
    <ProjectReference Include="../../src/PavlovBot.Rcon/PavlovBot.Rcon.csproj" />
    <ProjectReference Include="../../src/PavlovBot.Host/PavlovBot.Host.csproj" />
  </ItemGroup>
</Project>
