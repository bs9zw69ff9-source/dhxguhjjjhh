# Backup configuration for scripts/backup.sh
# Copy to  ../backup.env  (i.e. the bot root) and edit — backup.env is git-ignored.
#
#   cp scripts/backup.env.example backup.env

# rclone remote + path to upload backups to. Create the remote with `rclone config`.
# Examples:
#   b2:my-bucket/pavlov-bot-backups          (Backblaze B2)
#   s3:my-bucket/pavlov-bot-backups          (AWS S3)
#   r2:my-bucket/pavlov-bot-backups          (Cloudflare R2)
#   gdrive:pavlov-bot-backups                (Google Drive)
RCLONE_REMOTE=

# Delete remote backups older than this many days (default 30).
RETENTION_DAYS=30

# The directory the bot RUNS in - its pm2 cwd, where its .env and data/ live.
# Defaults to the parent of scripts/, which is only right if the bot runs from the
# repo. The live fallout bot runs elsewhere:
# BOT_DIR=/root/pavlov-bot-fallout
#
# The database is DATA_DIR/bot.db. DATA_DIR is read from BOT_DIR/.env when set
# there, and defaults to BOT_DIR/data. Override it here only if that is wrong.
# DATA_DIR=
