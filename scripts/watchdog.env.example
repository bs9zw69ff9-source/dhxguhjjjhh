# Configuration for scripts/watchdog.sh
# Copy to ../watchdog.env (the repo root) and edit - watchdog.env is git-ignored.
#
#   cp scripts/watchdog.env.example watchdog.env

# Discord webhook for the channel that should hear when the bot goes down. This URL is a
# credential: anyone holding it can post in that channel.
WATCHDOG_WEBHOOK=

# The bot's health endpoint. Needs METRICS_PORT set in the bot's .env.
# HEALTH_URL=http://127.0.0.1:9464/healthz

# Name used in the alert.
# BOT_NAME=Pavlov bot

# Consecutive failed checks (one a minute from cron) before alerting.
# FAILURES_BEFORE_ALERT=3
