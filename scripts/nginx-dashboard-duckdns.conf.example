# ─────────────────────────────────────────────────────────────────────────────
# nginx reverse proxy for the bot's web dashboard — DuckDNS (free domain) variant.
#
# Same as scripts/nginx-dashboard.conf.example, but for a free DuckDNS subdomain
# (YOURSUB.duckdns.org) instead of a domain you bought. Let's Encrypt issues certs
# for duckdns.org subdomains over the normal HTTP-01 challenge — no extra plugin.
#
# Setup (full walkthrough in the README, "DuckDNS (free subdomain)"):
#   1. Sign in at https://www.duckdns.org, create a subdomain, copy your token.
#   2. Set its IP to this VPS's public IP (paste it in the DuckDNS box, or use the
#      updater cron below if the IP ever changes).
#   3. In the bot's .env:
#        WEB_ENABLE=1
#        WEB_HOST=127.0.0.1
#        WEB_PORT=8080
#        WEB_SECURE_COOKIE=1
#        WEB_TRUST_PROXY=1
#        WEB_ADMIN_PASSWORD=<a strong password>
#      then: pm2 restart pavlov-bot
#   4. Open only 80/443:  sudo ufw allow 'Nginx Full'   (do NOT open 8080)
#   5. Install this file and run certbot (see the README).
#
# Replace YOURSUB.duckdns.org throughout.
# ─────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name YOURSUB.duckdns.org;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name YOURSUB.duckdns.org;

    # Filled in / managed by certbot after you run it.
    ssl_certificate     /etc/letsencrypt/live/YOURSUB.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOURSUB.duckdns.org/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 64k;

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}

# ── Optional: keep the DuckDNS record pointed here if this VPS has a dynamic IP ──
# DuckDNS auto-detects your IP when the "ip" param is left blank. Install as a cron
# (crontab -e) to refresh every 5 minutes — harmless to skip on a static-IP VPS:
#
#   */5 * * * * curl -fsS "https://www.duckdns.org/update?domains=YOURSUB&token=YOUR-DUCKDNS-TOKEN&ip=" >/dev/null 2>&1
#
# (YOURSUB is just the label, without ".duckdns.org".)
