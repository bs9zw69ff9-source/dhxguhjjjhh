# ─────────────────────────────────────────────────────────────────────────────
# nginx reverse proxy for the bot's web dashboard (web/server.js).
#
# Puts the dashboard behind HTTPS on a real domain, so the Node app itself only
# listens on localhost and is never exposed directly.
#
# Setup:
#   1. Point a DNS A record (e.g. dash.example.com) at this VPS.
#   2. In the bot's .env, bind the app to localhost + mark cookies Secure:
#        WEB_ENABLE=1
#        WEB_HOST=127.0.0.1
#        WEB_PORT=8080
#        WEB_SECURE_COOKIE=1
#        WEB_TRUST_PROXY=1
#        WEB_ADMIN_PASSWORD=<a strong password>
#      then: pm2 restart pavlov-bot
#   3. Do NOT open port 8080 in ufw — only 80/443 need to be reachable:
#        sudo ufw allow 'Nginx Full'      # or: sudo ufw allow 80,443/tcp
#   4. Install this file and get a certificate (see the Let's Encrypt block below).
#
# Replace dash.example.com with your domain throughout.
# ─────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name dash.example.com;

    # certbot writes ACME challenge files here; everything else redirects to HTTPS.
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name dash.example.com;

    # These two lines are filled in / managed by certbot after you run it.
    ssl_certificate     /etc/letsencrypt/live/dash.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dash.example.com/privkey.pem;

    # Modern TLS defaults.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Small panel; keep upload/body modest.
    client_max_body_size 64k;

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
