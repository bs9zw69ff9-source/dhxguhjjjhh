{
  // ── Fallout faction roster ────────────────────────────────────────────────
  // Point FACTIONS_PATH at a copy of this file. It REPLACES the built-in set
  // (Gambino, Colombo, NYPD) entirely, so this bot will not answer for those.
  //
  // RANKS ARE LOWEST FIRST. Order is the hierarchy: /promotion moves one entry
  // down this list to the next, /demotion moves back. "cap" is the maximum
  // members at that rank; omit it, or use 0, for uncapped.
  //
  // "spawnFile" is what actually lets somebody play as the faction. The rank
  // files decide what they get once they are in. The bot writes both.
  //
  // FILE NAMES MUST NOT COLLIDE WITH THE OTHER BOT'S. These are deliberately
  // prefixed ncr/legion/bos/enclave/kings/followers so they cannot touch
  // gambinospawn.txt, colombospawn.txt or the police*.txt files when both bots
  // share one game server. The bot refuses to start if two factions in THIS
  // file share a file, but it cannot see the other bot's roster - keep the
  // prefixes and there is nothing to collide with.
  //
  // The ladders and caps below are a starting point. Edit them and restart;
  // this is data, not code, so it needs no deploy.

  "factions": [
    {
      "name": "NCR",
      "spawnFile": "ncrspawn.txt",
      "ranks": [
        { "name": "Recruit",    "file": "ncrrecruit.txt",    "cap": 40 },
        { "name": "Trooper",    "file": "ncrtrooper.txt",    "cap": 25 },
        { "name": "Corporal",   "file": "ncrcorporal.txt",   "cap": 15 },
        { "name": "Sergeant",   "file": "ncrsergeant.txt",   "cap": 10 },
