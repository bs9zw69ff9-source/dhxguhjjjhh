{
  // ── Fallout faction roster ────────────────────────────────────────────────
  // Point FACTIONS_PATH at a copy of this file. It REPLACES the built-in set
  // (Gambino, Colombo, NYPD) entirely, so this bot will not answer for those.
  //
  // RANKS ARE LOWEST FIRST. Order is the hierarchy: /promotion moves one entry
  // down this list to the next, /demotion moves back.
  //
  // THERE ARE NO SIZE LIMITS. Ranks used to take a "cap"; they no longer do, and
  // a faction has never had a total. A rank holds as many members as it is
  // given. A file that still sets "cap" loads fine - the bot says how many it
  // ignored at startup - but the value does nothing, so do not add new ones.
  //
  // "spawnFile" is what actually lets somebody play as the faction. The rank
  // files decide what they get once they are in. The bot writes both.
  //
  // FILE NAMES MUST NOT COLLIDE WITH THE OTHER BOT'S. These are deliberately
  // prefixed ncr/legion/bos/enclave so they cannot touch
  // gambinospawn.txt, colombospawn.txt or the police*.txt files when both bots
  // share one game server. The bot refuses to start if two factions in THIS
  // file share a file, but it cannot see the other bot's roster - keep the
  // prefixes and there is nothing to collide with.
  //
  // The ladders below are a starting point. Edit them and restart;
  // this is data, not code, so it needs no deploy.

  "factions": [
    {
      "name": "NCR",
      "spawnFile": "ncrspawn.txt",
      "ranks": [
        { "name": "Recruit",    "file": "ncrrecruit.txt" },
        { "name": "Trooper",    "file": "ncrtrooper.txt" },
        { "name": "Corporal",   "file": "ncrcorporal.txt" },
        { "name": "Sergeant",   "file": "ncrsergeant.txt" },
        { "name": "Lieutenant", "file": "ncrlieutenant.txt" },
        { "name": "Captain",    "file": "ncrcaptain.txt" },
        { "name": "Colonel",    "file": "ncrcolonel.txt" }
      ],
      // Sub-classes are NOT ranks. A member keeps their rank and may hold one
      // of these as well, each with its own whitelist file.
      "subclasses": [
        { "name": "Ranger",         "file": "ncrranger.txt" },
        { "name": "Heavy Trooper",  "file": "ncrheavy.txt" }
      ]
    },
    {
      "name": "Legion",
      "spawnFile": "legionspawn.txt",
      "ranks": [
        { "name": "Recruit",   "file": "legionrecruit.txt" },
        { "name": "Prime",     "file": "legionprime.txt" },
        { "name": "Veteran",   "file": "legionveteran.txt" },
        { "name": "Decanus",   "file": "legiondecanus.txt" },
        { "name": "Centurion", "file": "legioncenturion.txt" },
        { "name": "Legate",    "file": "legionlegate.txt" }
      ],
      "subclasses": [
        { "name": "Frumentarius", "file": "legionfrumentarius.txt" }
      ]
    },
    {
      "name": "Brotherhood of Steel",
      "spawnFile": "bosspawn.txt",
      "ranks": [
        { "name": "Initiate",      "file": "bosinitiate.txt" },
        { "name": "Knight",        "file": "bosknight.txt" },
        { "name": "Senior Knight", "file": "bosseniorknight.txt" },
        { "name": "Paladin",       "file": "bospaladin.txt" },
        { "name": "Sentinel",      "file": "bossentinel.txt" },
        { "name": "Elder",         "file": "boselder.txt" }
      ],
      "subclasses": [
        { "name": "Scribe", "file": "bosscribe.txt" }
      ]
    },
    {
      "name": "Enclave",
      "spawnFile": "enclavespawn.txt",
      "ranks": [
        { "name": "Recruit",  "file": "enclaverecruit.txt" },
        { "name": "Soldier",  "file": "enclavesoldier.txt" },
        { "name": "Sergeant", "file": "enclavesergeant.txt" },
        { "name": "Officer",  "file": "enclaveofficer.txt" },
        { "name": "Colonel",  "file": "enclavecolonel.txt" }
      ]
    }
  ]
}
